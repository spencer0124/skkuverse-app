{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "beta": {
      "credentialsSource": "local",
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "EAS_BUILD_DISABLE_BUNDLE_JAVASCRIPT_STEP": "1"
      }
    },
    "production": {
      "credentialsSource": "local",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "EAS_BUILD_DISABLE_BUNDLE_JAVASCRIPT_STEP": "1"
      }
    }
  }
}
