rules_version = '2';

// Skkuverse Firestore Security Rules — Phase 2 (option D, no notifications collection).
//
// Deploy from repo root:
//   firebase deploy --only firestore:rules
//
// Admin SDK in Cloud Functions bypasses these rules, so server-only mutations
// (future Cloud Function writes to devices/{id}.active, preference sync) work
// regardless of the restrictions here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── In-app games ─────────────────────────────────────────────────────
    //
    // Games whose leaderboard exists. A new game adds its id here, and its
    // bounds in `isPlausible`, `maxEntryScore`, `maxRevives` and
    // `isImprovement`.
    function isGameId(gameId) {
      return gameId in ['wave-run', 'subway-typing'];
    }

    // Signed in with an @g.skku.edu Google account. The app checks the domain
    // before it signs in (google-auth.ts), but that is a client check; this is
    // the one a leaderboard entry has to pass. The Google identity is required
    // so an email/password account created with an skku address does not count.
    function isSkkuGoogle() {
      return request.auth != null
             && request.auth.token.email is string
             && request.auth.token.email.matches('^[a-z0-9._-]+@g[.]skku[.]edu$')
             && request.auth.token.email_verified == true
             && 'google.com' in request.auth.token.firebase.identities;
    }

    // users/{uid}.profile — who a player is on a leaderboard: a campus
    // (required) and a nickname that arrives with the first leaderboard entry.
    // Same pattern as `validateNickname` in
    // apps/mobile/src/features/profile/domain.ts.
    function isValidProfile(p) {
      return p is map
             && p.keys().hasAll(['campus', 'updatedAt'])
             && p.keys().hasOnly(['campus', 'nickname', 'updatedAt'])
             && p.campus in ['hssc', 'nsc']
             && (!('nickname' in p) || (p.nickname is string && p.nickname.matches('^[가-힣a-zA-Z0-9_]{2,12}$')))
             && p.updatedAt is timestamp;
    }

    // The highest score wave-run can reach `sec` seconds after its run was
    // stamped: the speed ramps from 6 by 0.001 a tick to 13 (reached at tick
    // 7000), distance is the sum of speeds, score is distance × 0.025, and 10 s
    // of slack covers the round trip before the stamp. Mirror of
    // packages/wave-run/src/game/bound.ts, whose tests pin the same values.
    function waveRunMaxScore(sec) {
      let t = (sec + 10) * 60;
      let d = t <= 7000 ? 6 * t + 0.0005 * t * t : 66500 + 13 * (t - 7000);
      return math.floor(d * 0.025);
    }

    // subway-typing scores a time in ms, and less is better, so what bounds it
    // is a floor: the whole route (238 keys) at 40 ms a key, 1,500 keys a
    // minute, beyond anyone on a phone. Mirror of MIN_RUN_MS in
    // packages/subway-typing/src/bound.ts, whose test pins the same value.
    function subwayTypingMinMs() {
      return 9520;
    }

    // Whether `score` could have been played in the `sec` seconds since the
    // run was stamped. wave-run: at most what its speed ramp reaches. A time:
    // no faster than the floor — that is the guard — and, as a sanity bound,
    // no longer than the time since the stamp. That bound's slack is generous
    // (two minutes) because nobody gains by claiming a slower time, while a
    // stamp re-taken at the start tap waits on App Check and can land after
    // the first key: a tight bound would refuse an honest run.
    function isPlausible(gameId, score, sec) {
      return gameId == 'wave-run' ? score <= waveRunMaxScore(sec)
           : gameId == 'subway-typing' ? score >= subwayTypingMinMs() && score <= (sec + 120) * 1000
           : false;
    }

    // The absolute cap on an entry: the five digits wave-run can show; for a
    // time, the hour a run can be entered in.
    function maxEntryScore(gameId) {
      return gameId == 'subway-typing' ? 3600000 : 99999;
    }

    // Revives a run can have used: wave-run's MAX_REVIVES; none elsewhere.
    function maxRevives(gameId) {
      return gameId == 'wave-run' ? 2 : 0;
    }

    // Which way a best moves: a time down, a distance up. Mirror of the
    // client's `isBetter` with the game's order (features/games/registry.ts).
    function isImprovement(gameId, next, prev) {
      return gameId == 'subway-typing' ? next < prev : next > prev;
    }

    // The run a score claims: the caller's own, of this game, entered within
    // an hour of its start, and plausible for the time since. wave-run's
    // ceiling grows with time, so the window is what keeps a stamped run from
    // being banked and entered later with a score nobody played for; an hour
    // is longer than any real run and caps what waiting alone can reach.
    function isEarnedOnRun(gameId, runId, score) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/gameRuns/$(runId);
      let run = get(path).data;
      return exists(path)
             && run.gameId == gameId
             && request.time < run.startedAt + duration.value(1, 'h')
             && isPlausible(gameId, score, (request.time - run.startedAt).seconds());
    }

    // What the entry says about the player is exactly their profile.
    function matchesProfile(d) {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile;
      return p.nickname == d.nickname && p.campus == d.campus;
    }

    // The masked email shown on the board: up to three leading characters of
    // the signed-in address. Restricted to [a-z0-9] so it cannot carry regex
    // syntax into the match below.
    function isOwnEmailPrefix(prefix) {
      return prefix is string
             && prefix.matches('^[a-z0-9]{1,3}$')
             && request.auth.token.email.matches('^' + prefix + '[^@]*@g[.]skku[.]edu$');
    }

    // A leaderboard entry as written by its player: every field present and
    // well-formed, earned on a stamped run, and matching their profile.
    function isValidEntry(gameId, uid, d) {
      return d.keys().hasOnly(['uid', 'runId', 'score', 'revives', 'nickname', 'emailPrefix', 'campus', 'updatedAt'])
             && d.keys().hasAll(['uid', 'runId', 'score', 'revives', 'nickname', 'emailPrefix', 'campus', 'updatedAt'])
             && d.uid == uid
             && d.runId is string
             && d.score is int
             && d.score >= 0
             && d.score <= maxEntryScore(gameId)
             && d.revives is int
             && d.revives >= 0
             && d.revives <= maxRevives(gameId)
             && d.updatedAt == request.time
             && isOwnEmailPrefix(d.emailPrefix)
             && isEarnedOnRun(gameId, d.runId, d.score)
             && matchesProfile(d);
    }

    // When a run of the caller's was stamped. The update rule reads the stamp of
    // the run a best was set on, so run documents must outlive the best that
    // cites them: never put a TTL on gameRuns without changing that rule.
    function runStart(runId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/gameRuns/$(runId)).data.startedAt;
    }

    // leaderboards/{gameId}/scores/{uid} — one entry per player: their best.
    // The document is theirs alone (its id is their uid), it only ever gets
    // better (`isImprovement`), and only a run newer than the one it holds can raise it, so a run
    // counts once and two runs cannot be alternated to keep climbing. The nickname and campus copies are
    // kept current by the onUserProfileWrite Cloud Function (admin SDK,
    // bypasses these rules).
    match /leaderboards/{gameId}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if isGameId(gameId)
                    && isSkkuGoogle()
                    && request.auth.uid == uid
                    && isValidEntry(gameId, uid, request.resource.data);
      allow update: if isGameId(gameId)
                    && isSkkuGoogle()
                    && request.auth.uid == uid
                    && isValidEntry(gameId, uid, request.resource.data)
                    && isImprovement(gameId, request.resource.data.score, resource.data.score)
                    && runStart(request.resource.data.runId) > runStart(resource.data.runId);
      allow delete: if false;
    }

    // A write that changes the profile at all is stamped by the server; one
    // that leaves it alone (a locale merge) is not asked to.
    function isProfileStamped() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      return !('profile' in after)
             || (('profile' in before) && after.profile == before.profile)
             || after.profile.updatedAt == request.time;
    }

    // Once a player has a nickname they have leaderboard entries, and each
    // change of nickname or campus rewrites all of them (onUserProfileWrite). So such a change waits ten minutes after the last
    // one, and the nickname, once set, stays.
    function isProfileChangeAllowed() {
      let before = resource == null ? {} : resource.data;
      let prev = before.get('profile', {});
      let next = request.resource.data.get('profile', {});
      return !('nickname' in prev)
             || (('nickname' in next)
                 && ((next.nickname == prev.nickname && next.campus == prev.campus)
                     || request.time > prev.updatedAt + duration.value(10, 'm')));
    }

    // users/{uid} — locale, the player profile and future user-level settings.
    // Never deleted by the client: the deleteAccount callable does it, after
    // the leaderboard entries.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && (!('profile' in request.resource.data) || isValidProfile(request.resource.data.profile))
                            && isProfileStamped()
                            && isProfileChangeAllowed();
      allow delete: if false;

      // users/{uid}/gameRuns/{runId} — a run's start, stamped by the server.
      // Anyone signed in may start one (an anonymous account that later links
      // Google keeps its uid, so a run played before sign-in can still be
      // entered). Immutable: the start time is the whole point.
      match /gameRuns/{runId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['gameId', 'startedAt'])
                      && isGameId(request.resource.data.gameId)
                      && request.resource.data.startedAt == request.time;
        allow update, delete: if false;
      }

      // users/{uid}/preferences/main — v5 SSOT (Phase F lockdown).
      //
      // INTENT (client writable):
      //   enabled, categoryEnabled, noticeTabEnabled, pickerSelections,
      //   miniAppSelections
      //
      // That list is descriptive, not enforced: the update rule below is a
      // DENYLIST on the two derived fields, so any OTHER field is admitted
      // whether or not it is named here. That is deliberate — it is what lets a
      // new intent field ship as an app OTA with no rules deploy beside it — but
      // it does mean this comment can go stale without anything failing.
      // DERIVED (CF only, blocked here):
      //   subscribedTopics, derivedAt
      //
      // The Cloud Function `onPreferencesWrite` writes subscribedTopics +
      // derivedAt with admin SDK (which bypasses these rules). Any client
      // attempt — accidental, malicious, or stale — is rejected.
      //
      // Create constraint: subscribedTopics must be empty or absent. CF fills
      // it within ~1-3s of the first intent write. Letting clients seed
      // arbitrary topics would defeat the SSOT invariant before derive runs.
      match /preferences/main {
        allow read: if request.auth != null && request.auth.uid == uid;

        // ESSENTIAL LOCK — categoryEnabled.essential 은 항상 true 여야 함.
        // UI lock + CF derive override + 이 Rules 의 3중 방어. legacy 사용자
        // 없는 단계라 단순 형태 — 어떤 write 든 essential != true 면 거부.
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && (
                        !('subscribedTopics' in request.resource.data) ||
                        request.resource.data.subscribedTopics.size() == 0
                      )
                      && (
                        !('categoryEnabled' in request.resource.data) ||
                        request.resource.data.categoryEnabled.essential == true
                      );

        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['subscribedTopics', 'derivedAt'])
                      && (
                        !('categoryEnabled' in request.resource.data) ||
                        request.resource.data.categoryEnabled.essential == true
                      )
                      // onboardedAt: 시드 시점에 'null → timestamp' 한 방향 전환만
                      // 허용. 이후 immutable. CF는 admin SDK라 이 룰 우회 가능.
                      // Used as canonical "user has onboarded" signal —
                      // useAppInit 리스너 + notices/index handler가 자동복원
                      // discriminator로 사용. Rules 테스트:
                      // firestore.rules.test.mjs "ONBOARDED_AT IMMUTABILITY" 4 케이스.
                      && (
                        resource.data.onboardedAt == request.resource.data.onboardedAt
                        || (resource.data.onboardedAt == null
                            && request.resource.data.onboardedAt is timestamp)
                      );

        allow delete: if false;
      }

      // users/{uid}/bookmarks/{key} — saved notices, Phase 1 Chunk A.
      //
      // Subcollection model (NOT a single doc with a map of entries):
      //   key = `${sourceId}:${articleNo}`
      //
      // Why subcollection: Firestore Rules cannot iterate map entries to assert
      // key/value consistency. Per-doc keying lets us compare the path variable
      // `{key}` directly to `request.resource.data.sourceId + ':' + string(articleNo)`,
      // which catches inconsistent writes (a key claiming one notice while the
      // body describes a different one).
      //
      // Why anchored regex `^[a-z0-9-]+$`: CEL `matches()` is partial-match by
      // default. Without `^...$`, `"valid:bad"` would slip through because the
      // substring `valid` matches `[a-z0-9-]+`. The "anchor canary" test in
      // firestore.rules.test.mjs is the regression guard for this.
      match /bookmarks/{key} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && key == request.resource.data.sourceId + ':' + string(request.resource.data.articleNo)
                              && request.resource.data.sourceId is string
                              && request.resource.data.sourceId.matches('^[a-z0-9-]+$')
                              && request.resource.data.articleNo is int
                              && request.resource.data.articleNo > 0
                              && request.resource.data.title is string
                              && request.resource.data.savedAt is timestamp;
      }
    }

    // feedback/{docId} — unified feedback collection. Two doc shapes keyed by
    // `type`:
    //   'review_prompt'    → client-created from the review-prompt 아쉬워요 sheet
    //   'account_deletion' → Admin SDK only, via the deleteAccount CF
    //
    // Anonymous by design (no uid field on either type). Append-only and never
    // client-readable — these are evidence of historical sentiment for product
    // analysis, not user-owned data.
    //
    // Clients may ONLY create well-formed 'review_prompt' docs. 'account_deletion'
    // docs are written by the Admin SDK (rules-bypassing), so no client path can
    // forge them — the create rule pins type to 'review_prompt'.
    //
    // `keys().hasOnly([...])` locks the field set so an authed client can't
    // smuggle extra fields (e.g. a uid) into the anonymous collection; optional
    // sourceId/articleNo absence is fine (hasOnly allows subsets). createdAt ==
    // request.time keeps writes forensic-grade (no client backdating). Anchored
    // regex `^[a-z0-9-]+$` — CEL matches() is partial by default (see the
    // bookmarks/{key} anchor-canary note).
    //
    // `source` is optional for backward compat with pre-v3 clients. When
    // present it must be a known surface id — allowlist prevents arbitrary
    // strings being injected into the anonymous collection.
    match /feedback/{docId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
                    && request.resource.data.type == 'review_prompt'
                    && request.resource.data.keys().hasOnly(['type', 'source', 'text', 'sourceId', 'articleNo', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.createdAt == request.time
                    && (
                      !('source' in request.resource.data) ||
                      request.resource.data.source in ['second_bookmark', 'inja_shuttle']
                    )
                    && (
                      !('sourceId' in request.resource.data) ||
                      (request.resource.data.sourceId is string
                       && request.resource.data.sourceId.matches('^[a-z0-9-]+$'))
                    )
                    && (
                      !('articleNo' in request.resource.data) ||
                      (request.resource.data.articleNo is int
                       && request.resource.data.articleNo > 0)
                    );
    }

    // devices/{deviceId} — top-level so the Cloud Function can query by
    // (active, notificationsEnabled, subscribedTopics) without hopping per uid.
    //
    // Writes require the caller's auth.uid to match the document's uid field.
    // Deletes are disabled — unregister is expressed as setting active: false.
    match /devices/{deviceId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // SECURITY TRADE — Task #12 (stale uid after anon→Google transition)
      //
      // Rule permits an authenticated user to claim a device doc IF:
      //   (a) they already own it (normal re-registration), OR
      //   (b) the doc is currently inactive (previous owner signed out).
      //
      // Rationale:
      //   - deviceId is a UUID4 stored only in device's MMKV; not enumerable,
      //     not transmitted outside Firestore writes.
      //   - App Check (App Attest / Play Integrity) gates all writes to
      //     attested builds only.
      //   - Active docs CANNOT be hijacked (condition 3a fails, 3b fails).
      //   - Inactive docs can be claimed by any authenticated user, but if
      //     the original owner returns, they can re-claim via 3b again
      //     (write is idempotent — new uid simply overwrites).
      //
      // Rejected attack: "malicious takeover of active doc" — blocked.
      // Accepted trade: "first-come-first-serve on inactive docs" — acceptable
      // because the physical device's legit user always wins on re-login
      // (their doc is inactive at that moment, so they claim it).
      //
      // See docs/plans/fcm-push-notifications.md:590
      allow update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && (
                      resource.data.uid == request.auth.uid
                      || resource.data.active == false
                    );
      allow delete: if false;
    }
  }
}
